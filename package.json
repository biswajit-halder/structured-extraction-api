{
  "name": "structured-extraction-api",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-cost, schema-validated resume/job-posting extraction API built on Cloudflare Workers + free OpenRouter models.",
  "type": "module",
  "scripts": {
